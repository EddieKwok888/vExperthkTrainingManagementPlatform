{
  "componentName": "UserDeleteModal",
  "props": [
    "isDeleteUserModalOpen",
    "setIsDeleteUserModalOpen",
    "sm",
    "max",
    "w",
    "md",
    "text",
    "red",
    "flex",
    "items",
    "center",
    "gap",
    "h",
    "Delete",
    "User",
    "Are",
    "you",
    "sure",
    "want",
    "to",
    "delete",
    "this",
    "user",
    "This",
    "action",
    "cannot",
    "be",
    "undone",
    "Please",
    "enter",
    "your",
    "admin",
    "password",
    "confirm",
    "userToDelete",
    "mt",
    "bg",
    "border",
    "rounded",
    "font",
    "bold",
    "name",
    "email",
    "xs",
    "role",
    "slate",
    "mb",
    "block",
    "Admin",
    "Password",
    "Enter",
    "adminPasswordForDelete",
    "e",
    "setAdminPasswordForDelete",
    "target",
    "full",
    "outline",
    "Cancel",
    "destructive",
    "handleDeleteUser",
    "loading",
    "hover",
    "Deleting"
  ],
  "block": "<Dialog open={isDeleteUserModalOpen} onOpenChange={setIsDeleteUserModalOpen}>\n        <DialogContent className=\"sm:max-w-md\">\n          <DialogHeader>\n            <DialogTitle className=\"text-red-600 flex items-center gap-2\">\n              <ShieldAlert className=\"w-5 h-5\" />\n              Delete User\n            </DialogTitle>\n            <DialogDescription>\n              Are you sure you want to delete this user? This action cannot be undone. Please enter your admin password to confirm.\n            </DialogDescription>\n            {userToDelete && (\n              <div className=\"mt-4 p-3 bg-red-50 border border-red-100 rounded-md\">\n                <div className=\"font-bold text-red-900\">{userToDelete.name || userToDelete.email}</div>\n                <div className=\"text-xs text-red-700\">{userToDelete.role}</div>\n              </div>\n            )}\n            <div className=\"mt-4\">\n              <Label className=\"text-xs font-bold text-slate-700 mb-1 block\">Admin Password</Label>\n              <Input \n                type=\"password\"\n                placeholder=\"Enter your password\"\n                value={adminPasswordForDelete}\n                onChange={e => setAdminPasswordForDelete(e.target.value)}\n                className=\"w-full\"\n              />\n            </div>\n          </DialogHeader>\n          <DialogFooter className=\"mt-4 gap-2 sm:gap-0\">\n            <Button variant=\"outline\" onClick={() => { setIsDeleteUserModalOpen(false); setAdminPasswordForDelete(''); }}>Cancel</Button>\n            <Button variant=\"destructive\" onClick={handleDeleteUser} disabled={loading || !adminPasswordForDelete} className=\"bg-red-600 hover:bg-red-700\">\n              {loading ? 'Deleting...' : 'Delete User'}\n            </Button>\n          </DialogFooter>\n        </DialogContent>\n      </Dialog>"
}