{
  "componentName": "ManualHoursModal",
  "props": [
    "isManualHoursModalOpen",
    "setIsManualHoursModalOpen",
    "max",
    "w",
    "md",
    "bg",
    "white",
    "border",
    "none",
    "shadow",
    "overflow",
    "hidden",
    "rounded",
    "indigo",
    "px",
    "py",
    "flex",
    "items",
    "center",
    "justify",
    "between",
    "text",
    "xl",
    "font",
    "bold",
    "mb",
    "Add",
    "Part",
    "time",
    "Record",
    "xs",
    "daily",
    "course",
    "part",
    "instructor",
    "h",
    "full",
    "form",
    "onSubmit",
    "handleManualHoursSubmit",
    "space",
    "y",
    "label",
    "slate",
    "uppercase",
    "tracking",
    "wider",
    "Instructor",
    "select",
    "lg",
    "sm",
    "manualHoursForm",
    "tutorId",
    "e",
    "setManualHoursForm",
    "target",
    "required",
    "option",
    "tutors",
    "t",
    "role",
    "tutor_pt",
    "name",
    "email",
    "grid",
    "cols",
    "gap",
    "date",
    "Course",
    "Name",
    "courses",
    "c",
    "title",
    "certName",
    "pt",
    "button",
    "outline",
    "Cancel",
    "submit",
    "isSubmittingManualHours",
    "hover",
    "Loader2",
    "animate",
    "spin",
    "Hours"
  ],
  "block": "<Dialog open={isManualHoursModalOpen} onOpenChange={setIsManualHoursModalOpen}>\n        <DialogContent className=\"max-w-md bg-white border-none shadow-2xl p-0 overflow-hidden rounded-2xl\">\n          <div className=\"bg-indigo-600 px-6 py-5 flex items-center justify-between\">\n            <div>\n              <DialogTitle className=\"text-xl font-bold text-white mb-1\">Add Part-time Record</DialogTitle>\n              <DialogDescription className=\"text-indigo-100 text-xs\">Record a daily course for a part-time instructor</DialogDescription>\n            </div>\n            <div className=\"w-10 h-10 rounded-full bg-white/10 flex items-center justify-center\">\n              <Clock className=\"w-5 h-5 text-indigo-50\" />\n            </div>\n          </div>\n          <form onSubmit={handleManualHoursSubmit} className=\"p-6 space-y-6\">\n            <div className=\"space-y-4\">\n              <div className=\"space-y-2\">\n                <label className=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">Select Instructor *</label>\n                <select \n                  className=\"w-full h-10 px-3 rounded-lg border border-slate-200 text-sm bg-white\"\n                  value={manualHoursForm.tutorId}\n                  onChange={e => setManualHoursForm({...manualHoursForm, tutorId: e.target.value})}\n                  required\n                >\n                  <option value=\"\">-- Select Instructor --</option>\n                  {tutors.filter(t => t.role === 'tutor_pt').map(t => (\n                    <option key={t.id} value={t.id}>{t.name || t.email}</option>\n                  ))}\n                </select>\n              </div>\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div className=\"space-y-2\">\n                  <label className=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">Date *</label>\n                  <Input \n                    type=\"date\" \n                    value={manualHoursForm.date} \n                    onChange={e => setManualHoursForm({...manualHoursForm, date: e.target.value})}\n                    required\n                  />\n                </div>\n                <div className=\"space-y-2\">\n                    <label className=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">Course Name *</label>\n                    <select\n                        className=\"w-full h-10 px-3 rounded-lg border border-slate-200 text-sm bg-white\"\n                        value={manualHoursForm.course}\n                        onChange={e => setManualHoursForm({...manualHoursForm, course: e.target.value})}\n                        required\n                    >\n                        <option value=\"\">-- Select Course --</option>\n                        {courses.map(c => (\n                            <option key={c.id} value={c.title || c.certName}>{c.title || c.certName}</option>\n                        ))}\n                    </select>\n                </div>\n              </div>\n\n            </div>\n            \n            <div className=\"pt-4 border-t border-slate-100 flex gap-3\">\n              <Button type=\"button\" variant=\"outline\" onClick={() => setIsManualHoursModalOpen(false)} className=\"flex-1 font-bold text-xs uppercase tracking-wider\">\n                Cancel\n              </Button>\n              <Button type=\"submit\" disabled={isSubmittingManualHours} className=\"flex-1 bg-indigo-600 hover:bg-indigo-700 font-bold text-xs uppercase tracking-wider gap-2\">\n                {isSubmittingManualHours ? <Loader2 className=\"w-4 h-4 animate-spin\" /> : <CheckCircle className=\"w-4 h-4\" />}\n                Add Hours\n              </Button>\n            </div>\n          </form>\n        </DialogContent>\n      </Dialog>"
}