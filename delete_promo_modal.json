  "componentName": "DeletePromoModal",
  "props": [
    "isDeletePromoModalOpen",
    "setIsDeletePromoModalOpen",
    "sm",
    "max",
    "w",
    "Delete",
    "Promotion",
    "py",
    "text",
    "slate",
    "Are",
    "you",
    "sure",
    "want",
    "to",
    "delete",
    "the",
    "promotion",
    "promoToDelete",
    "name",
    "This",
    "action",
    "cannot",
    "be",
    "undone",
    "outline",
    "Cancel",
    "destructive",
