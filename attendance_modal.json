{
  "componentName": "AttendanceModal",
  "props": [
    "isAttendanceModalOpen",
    "setIsAttendanceModalOpen",
    "sm",
    "max",
    "w",
    "pb",
    "border",
    "b",
    "slate",
    "text",
    "xl",
    "font",
    "black",
    "tracking",
    "tight",
    "Mark",
    "Attendance",
    "medium",
    "selectedLessonForAttendance",
    "lessonTitle",
    "lessonDate",
    "h",
    "overflow",
    "y",
    "auto",
    "px",
    "py",
    "bold",
    "uppercase",
    "widest",
    "xs",
    "Student",
    "Email",
    "center",
    "Status",
    "regs",
    "r",
    "sessionId",
    "status",
    "verified",
    "colSpan",
    "No",
    "students",
    "enrolled",
    "in",
    "this",
    "session",
    "studentName",
    "studentEmail",
    "flex",
    "justify",
    "gap",
    "present",
    "absent",
    "late",
    "excused",
    "button",
    "setAttendanceData",
    "prev",
    "studentId",
    "rounded",
    "lg",
    "transition",
    "all",
    "wider",
    "attendanceData",
    "bg",
    "green",
    "white",
    "shadow",
    "md",
    "red",
    "amber",
    "blue",
    "hover",
    "t",
    "end",
    "outline",
    "Cancel",
    "handleSaveAttendanceAdmin",
    "submittingAttendance",
    "Loader2",
    "mr",
    "animate",
    "spin"
  ],
  "block": "<Dialog open={isAttendanceModalOpen} onOpenChange={setIsAttendanceModalOpen}>\n        <DialogContent className=\"sm:max-w-[700px]\">\n          <DialogHeader className=\"p-6 pb-4 border-b border-slate-100\">\n            <DialogTitle className=\"text-xl font-black text-slate-800 tracking-tight\">Mark Attendance</DialogTitle>\n            <DialogDescription className=\"text-slate-500 font-medium\">\n              {selectedLessonForAttendance?.lessonTitle} ({selectedLessonForAttendance?.lessonDate})\n            </DialogDescription>\n          </DialogHeader>\n          <div className=\"max-h-[60vh] overflow-y-auto px-6 py-2\">\n            <Table>\n              <TableHeader>\n                <TableRow>\n                  <TableHead className=\"font-bold text-slate-400 uppercase tracking-widest text-xs\">Student</TableHead>\n                  <TableHead className=\"font-bold text-slate-400 uppercase tracking-widest text-xs\">Email</TableHead>\n                  <TableHead className=\"text-center font-bold text-slate-400 uppercase tracking-widest text-xs\">Status</TableHead>\n                </TableRow>\n              </TableHeader>\n              <TableBody>\n                {regs.filter(r => r.sessionId === selectedLessonForAttendance?.sessionId && r.status === 'verified').length === 0 ? (\n                  <TableRow>\n                    <TableCell colSpan={3} className=\"text-center py-8 text-slate-500 font-medium\">No verified students enrolled in this session.</TableCell>\n                  </TableRow>\n                ) : regs.filter(r => r.sessionId === selectedLessonForAttendance?.sessionId && r.status === 'verified').map(r => (\n                  <TableRow key={r.id}>\n                    <TableCell className=\"font-bold text-slate-700\">{r.studentName}</TableCell>\n                    <TableCell className=\"text-slate-500 text-xs\">{r.studentEmail}</TableCell>\n                    <TableCell className=\"text-center\">\n                      <div className=\"flex justify-center gap-1.5 sm:gap-2\">\n                        {['present', 'absent', 'late', 'excused'].map(status => (\n                          <button\n                            key={status}\n                            onClick={() => setAttendanceData(prev => ({ ...prev, [r.studentId]: status }))}\n                            className={`px-3 py-1.5 rounded-lg text-[9px] font-black uppercase transition-all tracking-wider border-2 ${\n                              attendanceData[r.studentId] === status \n                                ? (status === 'present' ? 'bg-green-600 border-green-600 text-white shadow-md' : \n                                   status === 'absent' ? 'bg-red-600 border-red-600 text-white shadow-md' :\n                                   status === 'late' ? 'bg-amber-500 border-amber-500 text-white shadow-md' : 'bg-blue-600 border-blue-600 text-white shadow-md')\n                                : 'border-slate-200 text-slate-400 bg-white hover:border-slate-300'\n                            }`}\n                          >\n                            {status}\n                          </button>\n                        ))}\n                      </div>\n                    </TableCell>\n                  </TableRow>\n                ))}\n              </TableBody>\n            </Table>\n          </div>\n          <DialogFooter className=\"p-6 border-t border-slate-100 flex gap-2 justify-end\">\n            <Button variant=\"outline\" onClick={() => setIsAttendanceModalOpen(false)}>Cancel</Button>\n            <Button onClick={handleSaveAttendanceAdmin} disabled={submittingAttendance} className=\"bg-slate-900 text-white hover:bg-slate-800\">\n              {submittingAttendance ? <Loader2 className=\"w-4 h-4 mr-2 animate-spin\" /> : <CheckCircle className=\"w-4 h-4 mr-2\" />}\n              Save Attendance\n            </Button>\n          </DialogFooter>\n        </DialogContent>\n      </Dialog>"
}