{
  "componentName": "DeleteConfirmModal",
  "props": [
    "deleteConfirmOpen",
    "setDeleteConfirmOpen",
    "sm",
    "max",
    "w",
    "flex",
    "items",
    "center",
    "gap",
    "text",
    "red",
    "font",
    "bold",
    "h",
    "itemToDelete",
    "course",
    "Delete",
    "Course",
    "Template",
    "session",
    "Room",
    "lesson",
    "Lesson",
    "Registration",
    "slate",
    "block",
    "mb",
    "semibold",
    "break",
    "words",
    "Deleting",
    "name",
    "Are",
    "you",
    "sure",
    "want",
    "to",
    "delete",
    "this",
    "template",
    "This",
    "will",
    "not",
    "affect",
    "existing",
    "sessions",
    "but",
    "the",
    "be",
    "permanently",
    "removed",
    "All",
    "scheduled",
    "lessons",
    "and",
    "data",
    "run",
    "action",
    "cannot",
    "undone",
    "payment",
    "record",
    "mt",
    "justify",
    "end",
    "outline",
    "none",
    "Cancel",
    "destructive",
    "shadow",
    "handleDelete",
    "loading",
    "Loader2",
    "animate",
    "spin",
    "mr",
    "Confirm"
  ],
  "block": "<Dialog open={deleteConfirmOpen} onOpenChange={setDeleteConfirmOpen}>\n        <DialogContent className=\"sm:max-w-[400px]\">\n          <DialogHeader>\n            <DialogTitle className=\"flex items-center gap-2 text-red-600 font-bold\">\n              <ShieldAlert className=\"w-5 h-5\" /> \n              {itemToDelete?.type === 'course' ? 'Delete Course Template' \n                : itemToDelete?.type === 'session' ? 'Delete Course Room' \n                : itemToDelete?.type === 'lesson' ? 'Delete Lesson'\n                : 'Delete Registration'}\n            </DialogTitle>\n            <DialogDescription className=\"text-slate-600\">\n              <span className=\"block mb-2 font-semibold text-slate-800 break-words\">\n                Deleting: {itemToDelete?.name}\n              </span>\n              {itemToDelete?.type === 'course' \n                ? \"Are you sure you want to delete this course template? This will not affect existing sessions but the template will be permanently removed.\"\n                : itemToDelete?.type === 'session' \n                  ? \"Are you sure you want to delete this session? All scheduled lessons and data for this run will be permanently removed.\"\n                  : itemToDelete?.type === 'lesson'\n                    ? \"Are you sure you want to delete this lesson? This action cannot be undone.\"\n                    : \"Are you sure you want to delete this payment record? This action cannot be undone.\"}\n            </DialogDescription>\n          </DialogHeader>\n          <DialogFooter className=\"mt-6 flex gap-2 sm:justify-end\">\n            <Button variant=\"outline\" className=\"flex-1 sm:flex-none\" onClick={() => setDeleteConfirmOpen(false)}>Cancel</Button>\n            <Button variant=\"destructive\" className=\"flex-1 sm:flex-none shadow-sm\" onClick={handleDelete} disabled={loading}>\n              {loading ? <Loader2 className=\"w-4 h-4 animate-spin mr-2\" /> : <Trash2 className=\"w-4 h-4 mr-2\" />}\n              Confirm Delete\n            </Button>\n          </DialogFooter>\n        </DialogContent>\n      </Dialog>"
}