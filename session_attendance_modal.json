{
  "componentName": "SessionAttendanceModal",
  "props": [
    "isSessionAttendanceModalOpen",
    "setIsSessionAttendanceModalOpen",
    "sm",
    "max",
    "w",
    "pb",
    "border",
    "b",
    "slate",
    "text",
    "xl",
    "font",
    "black",
    "tracking",
    "tight",
    "Manage",
    "Attendance",
    "medium",
    "class",
    "below",
    "to",
    "mark",
    "student",
    "attendance",
    "h",
    "overflow",
    "y",
    "auto",
    "px",
    "py",
    "space",
    "lessons",
    "l",
    "sessionId",
    "selectedSessionForAttendance",
    "idx",
    "rounded",
    "hover",
    "indigo",
    "transition",
    "all",
    "bg",
    "white",
    "shadow",
    "flex",
    "items",
    "center",
    "justify",
    "between",
    "group",
    "gap",
    "shrink",
    "full",
    "bold",
    "lessonTitle",
    "Lesson",
    "mt",
    "uppercase",
    "wider",
    "lessonDate",
    "startTime",
    "endTime",
    "outline",
    "xs",
    "handleOpenAttendanceModal",
    "ClipboardList",
    "mr",
    "Mark",
    "dashed",
    "mb",
    "No",
    "classes",
    "scheduled",
    "this",
    "session",
    "yet",
    "default",
    "setViewingLessonsForSession",
    "setActiveTab",
    "sessions",
    "Go",
    "Class",
    "Scheduler",
    "t",
    "ghost",
    "Close"
  ],
  "block": "<Dialog open={isSessionAttendanceModalOpen} onOpenChange={setIsSessionAttendanceModalOpen}>\n        <DialogContent className=\"sm:max-w-[700px]\">\n          <DialogHeader className=\"p-6 pb-4 border-b border-slate-100\">\n            <DialogTitle className=\"text-xl font-black text-slate-800 tracking-tight\">Manage Attendance</DialogTitle>\n            <DialogDescription className=\"text-slate-500 font-medium\">\n              Select a class below to mark student attendance.\n            </DialogDescription>\n          </DialogHeader>\n          <div className=\"max-h-[60vh] overflow-y-auto px-6 py-2\">\n            <div className=\"space-y-3\">\n              {lessons.filter(l => l.sessionId === selectedSessionForAttendance?.id).map((l, idx) => (\n                <div key={l.id} className=\"p-4 border rounded-xl hover:border-indigo-200 transition-all bg-white shadow-sm flex items-center justify-between group\">\n                  <div className=\"flex items-center gap-4\">\n                    <div className=\"h-10 w-10 shrink-0 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center font-black text-sm border border-indigo-100\">\n                      {idx + 1}\n                    </div>\n                    <div>\n                      <div className=\"font-bold text-slate-800 text-sm\">{l.lessonTitle || `Lesson ${idx + 1}`}</div>\n                      <div className=\"flex items-center gap-2 mt-1\">\n                        <span className=\"text-[10px] uppercase font-bold tracking-wider text-slate-400 bg-slate-50 px-2 py-0.5 rounded border border-slate-100\">\n                          {l.lessonDate}\n                        </span>\n                        <span className=\"text-[10px] text-slate-400 font-medium\">\n                          {l.startTime} - {l.endTime}\n                        </span>\n                      </div>\n                    </div>\n                  </div>\n                  <div>\n                    <Button variant=\"outline\" size=\"sm\" className=\"h-8 px-4 text-xs font-bold uppercase tracking-wider text-indigo-600 border-indigo-200 hover:bg-indigo-50\" onClick={() => handleOpenAttendanceModal(l)}>\n                      <ClipboardList className=\"w-3.5 h-3.5 mr-1.5\" /> Mark Attendance\n                    </Button>\n                  </div>\n                </div>\n              ))}\n              {lessons.filter(l => l.sessionId === selectedSessionForAttendance?.id).length === 0 && (\n                <div className=\"text-center py-12 text-slate-400 text-sm font-medium border border-dashed rounded-xl bg-slate-50\">\n                  <p className=\"mb-4\">No classes scheduled for this session yet.</p>\n                  <Button \n                    variant=\"default\" \n                    className=\"bg-indigo-600 hover:bg-indigo-700 font-bold uppercase tracking-wider text-xs\"\n                    onClick={() => {\n                      setIsSessionAttendanceModalOpen(false);\n                      setViewingLessonsForSession(selectedSessionForAttendance);\n                      setActiveTab('sessions');\n                    }}\n                  >\n                    Go to Class Scheduler\n                  </Button>\n                </div>\n              )}\n            </div>\n          </div>\n          <DialogFooter className=\"p-4 border-t border-slate-100\">\n            <Button variant=\"ghost\" onClick={() => setIsSessionAttendanceModalOpen(false)} className=\"w-full font-bold text-xs uppercase tracking-[0.2em] text-slate-500\">Close</Button>\n          </DialogFooter>\n        </DialogContent>\n      </Dialog>"
}